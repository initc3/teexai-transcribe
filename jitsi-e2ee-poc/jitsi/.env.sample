# Copy to .env, then run ./gen-passwords.sh to fill the *_PASSWORD fields.
# Self-contained POC: anonymous join, self-signed HTTPS, bots reach `web` in-network.
CONFIG=./config
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC
PUBLIC_URL=https://jitsi-web:8443
JITSI_IMAGE_VERSION=stable-9646
RESTART_POLICY=no
# Host-side colibri debug port (remapped off 8080 to avoid conflicts).
JVB_COLIBRI_PORT=18080

JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
